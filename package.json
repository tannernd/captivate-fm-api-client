{
  "name": "captivate-fm-api-client",
  "version": "1.0.0",
  "description": "A Node.js client for the Captivate.fm API. Upload media, create episodes, and manage authentication.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./dist/index.cjs.js",
      "import": "./dist/index.esm.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch --config jest.config.js",
    "smoke": "node scripts/smoke.cjs && node scripts/smoke.mjs"
  },
  "keywords": [
    "captivate",
    "podcast",
    "api",
    "client",
    "uploader",
    "episodes",
    "node"
  ],
  "author": "Nate Tanner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tannernd/captivate-fm-api-client.git"
  },
  "bugs": {
    "url": "https://github.com/tannernd/captivate-fm-api-client/issues"
  },
  "homepage": "https://github.com/tannernd/captivate-fm-api-client#readme",
  "dependencies": {
    "axios": "^1.6.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "jest": "^29.7.0",
    "rollup": "^4.0.0"
  },
  "types": "index.d.ts",
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
